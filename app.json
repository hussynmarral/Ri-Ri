{
  "expo": {
    "name": "Ri Ri",
    "slug": "ri-ri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "riri",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hussynmarral.riri",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Ri Ri uses notifications to remind you of upcoming schedule blocks and water intake goals.",
        "NSSpeechRecognitionUsageDescription": "Ri Ri uses speech recognition to let you talk to the AI assistant hands-free.",
        "NSMicrophoneUsageDescription": "Ri Ri needs microphone access for voice commands to the AI assistant."
      }
    },
    "android": {
      "package": "com.hussynmarral.riri",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Ri Ri",
      "shortName": "Ri Ri",
      "description": "Your personal operating system",
      "themeColor": "#6366F1",
      "backgroundColor": "#0F0F10",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F10"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#6366F1",
          "iosDisplayInForeground": true,
          "androidMode": "default"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "58f18068-66fd-4e19-bad3-6e7e17223514"
      },
      "router": {}
    },
    "owner": "ri-ris-team"
  }
}
